# Copy into each stack directory as terraform.tfvars (gitignored) and fill in.
# Nothing that identifies an account lives in the repository.
profile    = "my-aws-profile"
account_id = "000000000000"

# ad-server, guardrails
alert_email = "you@example.com"

# cicd: `gh api repos/<owner>/<repo>/actions/oidc/customization/sub`
github_owner_id = "my-user@12345678"
github_repo_id  = "123456789"

# scheduler
repo = "my-user/adtech-lab"
